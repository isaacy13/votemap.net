{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup local D1",
            "type": "shell",
            "command": "npx wrangler d1 execute votemap-db --local --file=migrations/0001_initial.sql",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "npm run build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$tsc"]
        }
    ]
}
