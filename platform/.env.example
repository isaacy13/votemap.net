# Database
DATABASE_URL=postgresql://votemap:votemap_dev@localhost:5432/votemap

# Redis
REDIS_URL=redis://localhost:6379

# JWT (min 32 chars)
JWT_SECRET=change-this-to-a-secure-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=604800

# Identity — ZKPassport (free, open source). No API key required for self-serve SDK.
ZKPASSPORT_DOMAIN=localhost
# Allow mock passport verification for local/CI ($0, no mobile app needed)
ZKPASSPORT_DEV_MODE=true
ALLOW_DEV_LOGIN=true

# Face ID vote-session TTL (seconds)
VOTE_SESSION_TTL_SEC=120

# Google OAuth (comma-separated client IDs for audience check)
GOOGLE_CLIENT_IDS=

# S3-compatible Storage (Cloudflare R2 / MinIO / local)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=votemap-proofs
S3_ACCESS_KEY=votemap
S3_SECRET_KEY=votemap_dev

# Solana (Phase 2)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*
