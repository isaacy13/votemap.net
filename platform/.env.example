# Database
DATABASE_URL=postgresql://votemap:votemap_dev@localhost:5432/votemap

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-secure-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=604800

# X (Twitter) API
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Google OAuth Client IDs (for frontend)
# Create at https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# X (Twitter) OAuth Client ID (for frontend)
EXPO_PUBLIC_X_CLIENT_ID=

# S3-compatible Storage (Cloudflare R2 / MinIO / local)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=votemap-proofs
S3_ACCESS_KEY=votemap
S3_SECRET_KEY=votemap_dev

# Circle (USDC)
CIRCLE_API_KEY=

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*
